# Másold .env néven, és töltsd ki. A .env titkokat tartalmaz: ne tedd verziókezelőbe.
DOMAIN=sporolos.example.com
# csak betű, szám, - és _ (a DATABASE_URL-be kerül); pl.: openssl rand -hex 24
DB_PASSWORD=
# legalább 12 karakter; pl.: openssl rand -base64 18
ADMIN_PASSWORD=
MARKETS=hu,hr
# opcionális:
# RATE_LIMIT=600
# MAX_CONCURRENT=64
# DB_POOL_SIZE=10
# APP_MEMORY=1g
# JAVA_OPTS=-XX:MaxRAMPercentage=70
